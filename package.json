{
    "name": "@fullstacked/p2p",
    "version": "0.4.0",
    "description": "Client driver for FullStacked P2P: presence, messaging, shared state and media between peers, over WebRTC with a TCP relay fallback. Runs in the FullStacked runtime and Node.js.",
    "keywords": [
        "p2p",
        "webrtc",
        "presence",
        "realtime",
        "collaboration",
        "fullstacked"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fullstackedorg/p2p.git"
    },
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "exports": {
        ".": {
            "types": "./src/client/index.ts",
            "node": "./dist/index.js",
            "default": "./src/client/index.ts"
        }
    },
    "scripts": {
        "build": "node scripts/build-driver.ts",
        "prepare": "node scripts/build-driver.ts",
        "start": "node src/server/main.ts",
        "fmt": "prettier --write .",
        "fmt:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "check:loc": "node scripts/check-loc.ts --max 300",
        "check": "npm run fmt:check && npm run typecheck && npm run check:loc",
        "test": "TEST=1 node --test test/*.test.ts",
        "test:coverage": "TEST=1 node --test --experimental-test-coverage test/*.test.ts",
        "test:integration": "node scripts/test-integration.ts"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "es5",
        "printWidth": 100,
        "arrowParens": "always"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.10",
        "puppeteer": "^25.16.0",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild": true,
        "puppeteer": true
    },
    "license": "MIT"
}
